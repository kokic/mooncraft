///|
/// Publish scalar configuration and initial world metadata for JS bootstrap.
fn publish_client_config(world : @level.World) -> Unit {
  publish_global("mcUpdateLabel", "1:10")
  publish_global("mcSaveSchemaVersion", @save.SAVE_SCHEMA_VERSION)
  publish_global("mcWorldSeed", world.seed())
  publish_global("mcWorldType", world.world_type_name())
  publish_global("mcChunkSize", @level.CHUNK_X_SIZE)
  publish_global("mcWorldMinY", world.min_y())
  publish_global("mcWorldMaxY", world.max_y())
  publish_global("mcRenderDistance", @render.DEFAULT_CHUNK_RENDER_DISTANCE)
  publish_global("mcChunkGenPerFrame", @render.CHUNK_GENERATION_BUDGET)
  publish_global("mcMeshBuildPerFrame", @render.CHUNK_MESH_BUDGET)
  publish_global("mcChunkSectionSize", @render.CHUNK_SECTION_SIZE)
  publish_global("mcDebugChunkGen", false)
  publish_global("mcDebugSolid", false)
  publish_global("mcUseFixedLight", @level.USE_FIXED_LIGHT)
  publish_global("mcFov", 60)
  publish_global("mcInventoryGridX", @player.INVENTORY_GRID_X)
  publish_global("mcInventoryGridY", @player.INVENTORY_GRID_Y)
  publish_global("mcAirLongId", @block.AIR_LONG_ID)
  publish_global("mcWaterTintGridStep", 4)
  publish_global("mcSpawnChunkX", @player.SPAWN_CHUNK_X)
  publish_global("mcSpawnChunkZ", @player.SPAWN_CHUNK_Z)
  publish_global("mcSpawnLocalX", @player.SPAWN_LOCAL_X)
  publish_global("mcSpawnLocalZ", @player.SPAWN_LOCAL_Z)
  publish_global("mcSpawnSurfaceOffset", @player.SPAWN_SURFACE_OFFSET)
  publish_global("mcSpawnFallbackY", @player.SPAWN_FALLBACK_Y)
  publish_global("mcSpawnYaw", @player.SPAWN_YAW)
  publish_global("mcSpawnPitch", @player.SPAWN_PITCH)
  publish_global("mcUpVector", @math3d.up_vector)
  publish_global("mcOakLeavesVertexShader", @render.leaf_vertex_shader)
  publish_global("mcOakLeavesFragmentShader", @render.leaf_fragment_shader)
  publish_global("mcOakLeavesDefaultTint", @genus.default_tint)
}
