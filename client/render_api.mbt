///|
/// Publish pure camera, matrix, quaternion, mesh, and GLTF rendering APIs.
fn register_render_api() -> Unit {
  publish_global("mcCameraFromYawPitch", @render.camera_from_yaw_pitch)
  publish_global("mcCameraFromYawPitchInto", @math3d.camera_from_yaw_pitch_into)
  publish_global("mcMat4Create", @render.mat4_create)
  publish_global("mcMat4Copy", @render.mat4_copy)
  publish_global("mcMat4Perspective", @render.mat4_perspective)
  publish_global("mcMat4Ortho", @render.mat4_ortho)
  publish_global("mcMat4LookAt", @render.mat4_look_at)
  publish_global("mcMat4Mul", @render.mat4_mul)
  publish_global("mcMat4FromTRS", @render.mat4_from_trs)
  publish_global("mcTransformPoint", @render.transform_point)
  publish_global("mcQuatNormalize", @math3d.quat_normalize)
  publish_global("mcQuatMul", @math3d.quat_mul)
  publish_global("mcQuatApplyYawOffset", @math3d.quat_apply_yaw_offset)
  publish_global("mcQuatFromYawPitch", @math3d.quat_from_yaw_pitch)
  publish_global("mcQuatSlerp", @math3d.quat_slerp)
  publish_global("mcCreateBlockRegistry", @render.BlockRegistry::create)
  publish_global(
    "mcGetRenderBlockByLongId",
    @render.BlockRegistry::get_by_long_id,
  )
  publish_global("mcBuildUiItemMesh", @render.build_ui_item_mesh)
  publish_global("mcParseGlb", @render.parse_glb)
  publish_global("mcReadAccessorValues", @render.read_accessor_values)
  publish_global("mcReadIndices", @render.read_indices)
  publish_global("mcCreateGltfProgram", @render.create_gltf_program)
  publish_global("mcGltfVsSource", @render.GLTF_VS_SOURCE)
  publish_global("mcGltfFsSource", @render.GLTF_FS_SOURCE)
  publish_global("mcCreateWhiteTexture", @render.create_white_texture)
  publish_global("mcCreateTextureFromImage", @render.create_texture_from_image)
  publish_global("mcBuildGltfPrimitive", @render.build_gltf_primitive)
  publish_global("mcDisposeGltfPrimitives", @render.dispose_gltf_primitives)
  publish_global("mcCreateGltfRenderer", @render.create_gltf_renderer)
  publish_global("mcUpdateGltfRenderer", @render.update_gltf_renderer)
  publish_global("mcRenderGltfRenderer", @render.render_gltf_renderer)
  publish_global("mcGltfSetAnimation", @render.gltf_set_animation)
  publish_global("mcGltfSetTexture", @render.gltf_set_texture)
  publish_global("mcGltfSetRotation", @render.gltf_set_rotation)
  publish_global("mcGltfSetYaw", @render.gltf_set_yaw)
  publish_global("mcGltfSetScale", @render.gltf_set_scale)
  publish_global("mcGltfLookAtXz", @render.gltf_look_at_xz)
  publish_global("mcGltfLookAtXyz", @render.gltf_look_at_xyz)
  publish_global("mcGltfEntityIds", @render.gltf_entity_ids)
  publish_global("mcGltfEntityCount", @render.gltf_entity_count)
}
