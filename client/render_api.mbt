///|
/// Publish pure camera, matrix, quaternion, mesh, and GLTF rendering APIs.
pub fn register_render_api() -> Unit {
  @ffi.cast_global_set("mcCameraFromYawPitch", @render.camera_from_yaw_pitch)
  @ffi.cast_global_set("mcCameraFromYawPitchInto", @math3d.camera_from_yaw_pitch_into)
  @ffi.cast_global_set("mcMat4Create", @render.mat4_create)
  @ffi.cast_global_set("mcMat4Copy", @render.mat4_copy)
  @ffi.cast_global_set("mcMat4Perspective", @render.mat4_perspective)
  @ffi.cast_global_set("mcMat4Ortho", @render.mat4_ortho)
  @ffi.cast_global_set("mcMat4LookAt", @render.mat4_look_at)
  @ffi.cast_global_set("mcMat4Mul", @render.mat4_mul)
  @ffi.cast_global_set("mcMat4FromTRS", @render.mat4_from_trs)
  @ffi.cast_global_set("mcTransformPoint", @render.transform_point)
  @ffi.cast_global_set("mcQuatNormalize", @math3d.quat_normalize)
  @ffi.cast_global_set("mcQuatMul", @math3d.quat_mul)
  @ffi.cast_global_set("mcQuatApplyYawOffset", @math3d.quat_apply_yaw_offset)
  @ffi.cast_global_set("mcQuatFromYawPitch", @math3d.quat_from_yaw_pitch)
  @ffi.cast_global_set("mcQuatSlerp", @math3d.quat_slerp)
  @ffi.cast_global_set("mcCreateBlockRegistry", @render.BlockRegistry::create)
  @ffi.cast_global_set(
    "mcGetRenderBlockByLongId",
    @render.BlockRegistry::get_by_long_id,
  )
  @ffi.cast_global_set("mcBuildUiItemMesh", @render.build_ui_item_mesh)
  @ffi.cast_global_set("mcParseGlb", @render.parse_glb)
  @ffi.cast_global_set("mcReadAccessorValues", @render.read_accessor_values)
  @ffi.cast_global_set("mcReadIndices", @render.read_indices)
  @ffi.cast_global_set("mcCreateGltfProgram", @render.create_gltf_program)
  @ffi.cast_global_set("mcGltfVsSource", @render.GLTF_VS_SOURCE)
  @ffi.cast_global_set("mcGltfFsSource", @render.GLTF_FS_SOURCE)
  @ffi.cast_global_set("mcCreateWhiteTexture", @render.create_white_texture)
  @ffi.cast_global_set("mcCreateTextureFromImage", @render.create_texture_from_image)
  @ffi.cast_global_set("mcBuildGltfPrimitive", @render.build_gltf_primitive)
  @ffi.cast_global_set("mcDisposeGltfPrimitives", @render.dispose_gltf_primitives)
  @ffi.cast_global_set("mcCreateGltfRenderer", @render.create_gltf_renderer)
  @ffi.cast_global_set("mcUpdateGltfRenderer", @render.update_gltf_renderer)
  @ffi.cast_global_set("mcRenderGltfRenderer", @render.render_gltf_renderer)
  @ffi.cast_global_set("mcGltfSetAnimation", @render.gltf_set_animation)
  @ffi.cast_global_set("mcGltfSetTexture", @render.gltf_set_texture)
  @ffi.cast_global_set("mcGltfSetRotation", @render.gltf_set_rotation)
  @ffi.cast_global_set("mcGltfSetYaw", @render.gltf_set_yaw)
  @ffi.cast_global_set("mcGltfSetScale", @render.gltf_set_scale)
  @ffi.cast_global_set("mcGltfLookAtXz", @render.gltf_look_at_xz)
  @ffi.cast_global_set("mcGltfLookAtXyz", @render.gltf_look_at_xyz)
  @ffi.cast_global_set("mcGltfEntityIds", @render.gltf_entity_ids)
  @ffi.cast_global_set("mcGltfEntityCount", @render.gltf_entity_count)
}
